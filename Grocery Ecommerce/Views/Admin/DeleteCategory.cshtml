@model Grocery_Ecommerce.Models.Category
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Category";
}

<div class="admin-header">
    <h2>Delete Category</h2>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="admin-card" style="border-left-color: #e74c3c;">
            <h4 style="color: #e74c3c; margin-top: 0;">Confirm Delete</h4>
            <p>Are you sure you want to delete this category?</p>
            <div style="background: #fff3cd; padding: 15px; border-radius: 5px; margin: 20px 0; color: #856404;">
                <strong>Category:</strong> @Model.Name
            </div>
            <form asp-controller="Admin" asp-action="DeleteCategoryConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.CategoryId" />
                <div style="display: flex; gap: 10px;">
                    <button type="submit" class="btn btn-primary-admin" style="background: #e74c3c;">Yes, Delete</button>
                    <a href="@Url.Action("Categories", "Admin")" class="btn btn-primary-admin" style="background: #95a5a6; text-decoration: none;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
