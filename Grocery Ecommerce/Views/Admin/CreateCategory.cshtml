@model Grocery_Ecommerce.Models.Category
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Category";
}

<div class="admin-header">
    <h2>Create New Category</h2>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="admin-card">
            <form asp-controller="Admin" asp-action="CreateCategory" method="post">
                <div class="form-group-admin">
                    <label asp-for="Name">Category Name</label>
                    <input asp-for="Name" placeholder="Enter category name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group-admin">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description" rows="5" placeholder="Enter category description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div style="display: flex; gap: 10px; margin-top: 25px;">
                    <button type="submit" class="btn btn-primary-admin">Save Category</button>
                    <a href="@Url.Action("Categories", "Admin")" class="btn btn-primary-admin" style="background: #95a5a6; text-decoration: none;">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>
