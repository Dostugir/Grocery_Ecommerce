@using System.Security.Cryptography
@model IEnumerable<Grocery_Ecommerce.Models.CartItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Checkout";
    var addresses = ViewBag.Addresses as List<Grocery_Ecommerce.Models.Address> ?? new List<Grocery_Ecommerce.Models.Address>();
    var subtotal = ViewBag.Total != null ? (decimal)ViewBag.Total : 0m;
    var tax = subtotal * 0.05m;
    var total = subtotal + tax;
}


@if (!Model.Any())
    {
        <div class="empty-cart-state">
            <h2>Your cart is empty</h2>
            <p>Looks like you haven't added any items to your cart yet. Start shopping to find fresh groceries!</p>
            <a href="/Products" class="btn-primary" style="display: inline-block; width: auto; margin-top: 1rem; text-decoration: none;">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="checkout-container">
            <!-- Items Section -->
            <div class="checkout-items">
                <h2>Items in Cart</h2>
                @foreach (var item in Model)
                {
                    <div class="checkout-item">
                        <div class="item-image">
                            <img src="@(item.Product?.ImageUrl ?? "https://via.placeholder.com/80")" alt="@item.Product?.Name" onerror="this.src='https://via.placeholder.com/80'" />
                        </div>
                        <div class="item-details">
                            <div class="item-name">@item.Product?.Name</div>
                            <div class="item-price">@item.Product?.Price.ToString("0.00")Tk per unit</div>
                            <div class="item-controls">
                                <div class="quantity-control">
                                    <button type="button">?</button>
                                    <input type="number" value="@item.Quantity" readonly />
                                    <button type="button">+</button>
                                </div>
                                <button class="remove-btn">Remove</button>
                            </div>
                        </div>
                    <div class="item-subtotal">@(item.Quantity * (item.Product?.Price ?? 0))Tk</div>
                    </div>
                }
            </div>

            <!-- Order Summary Sidebar -->
            <div class="order-summary">
                <h3>Order Summary</h3>
                
                <div class="summary-row">
                    <span>Subtotal:</span>
                <span>@subtotal.ToString("0.00")Tk</span>
                </div>
                
                <div class="summary-row">
                    <span>Delivery:</span>
                    <span style="color: var(--accent);">FREE</span>
                </div>
                
                <div class="summary-row">
                    <span>Tax (5%):</span>
                <span>@tax.ToString("0.00")Tk</span>
                </div>
                
                <div class="summary-row total">
                    <span>Total:</span>
                <span class="total-amount">@total.ToString("0.00")Tk</span>
                </div>

                <div class="promo-section">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.75rem; color: #111827; font-size: 0.95rem;">Have a coupon?</label>
                    <div class="promo-input-group">
                        <input type="text" placeholder="Enter promo code" />
                        <button type="button">Apply</button>
                    </div>
                </div>

                <!-- Delivery Address Section -->
                <form asp-controller="Checkout" asp-action="PlaceOrder" method="post">
                    @if (TempData["Error"] != null)
                    {
                        <div style="background-color: #fee; color: #c00; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; border-left: 4px solid #c00;">
                            @TempData["Error"]
                        </div>
                    }

                    <div style="margin-bottom: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                            <label style="display: block; font-weight: 600; color: #111827; font-size: 0.95rem;">Delivery Address <span style="color: red;">*</span></label>
                            <a href="/User/Profile" style="color: #27ae60; text-decoration: none; font-size: 0.9rem; font-weight: 600;">Manage Addresses</a>
                        </div>

                        @if (addresses.Count == 0)
                        {
                            <div style="background-color: #fef3c7; color: #92400e; padding: 0.75rem; border-radius: 0.5rem; border-left: 4px solid #f59e0b; margin-bottom: 1rem;">
                                <strong>No addresses found.</strong> 
                                <a href="/User/Profile" style="color: #92400e; text-decoration: underline; font-weight: 600;">Add a delivery address</a> to your account before placing an order.
                            </div>
                        }
                        else
                        {
                            <div class="address-select-wrapper">
                                <select name="deliveryAddressId" id="deliveryAddressId" required style="width: 100%; padding: 0.625rem; border: 1px solid #ddd; border-radius: 0.375rem; font-size: 0.95rem;">
                                    <option value="0">-- Select a delivery address --</option>
                                    @foreach (var address in addresses)
                                    {
                                        <option value="@address.AddressId">
                                            @address.Street, @address.City, @address.State @address.PostalCode
                                            @if (address.IsDefault)
                                            {
                                                <span>(Default)</span>
                                            }
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Address Preview Card -->
                            <div id="addressPreview" style="display: none; margin-top: 1rem; padding: 1rem; background-color: #f0f9ff; border: 1px solid #93c5fd; border-radius: 0.375rem;">
                                <div style="font-weight: 600; color: #1e40af; margin-bottom: 0.5rem;">Selected Address:</div>
                                <div id="previewContent" style="color: #1f2937; font-size: 0.95rem; line-height: 1.6;"></div>
                            </div>
                        }
                    </div>

                    @if (addresses.Count > 0)
                    {
                        <button type="submit" class="btn-primary">Place Order</button>
                    }
                    else
                    {
                        <button type="button" class="btn-primary" disabled style="opacity: 0.6; cursor: not-allowed;">Place Order</button>
                    }
                </form>

                <a href="/Cart" class="btn-secondary">Back to Cart</a>

                <div class="trust-indicators">
                    <div>
                        <div class="trust-badge">?</div>
                        <span>Secure checkout</span>
                    </div>
                    <div>
                        <div class="trust-badge">?</div>
                        <span>Easy returns within 7 days</span>
                    </div>
                    <div>
                        <div class="trust-badge">?</div>
                        <span>24/7 customer support</span>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Address preview functionality
            const addressSelect = document.getElementById('deliveryAddressId');
            const addressPreview = document.getElementById('addressPreview');
            const previewContent = document.getElementById('previewContent');

            const addressData = {
                @foreach (var address in addresses)
                {
                    <text>
                    @address.AddressId: {
                        street: '@address.Street',
                        city: '@address.City',
                        state: '@address.State',
                        postal: '@address.PostalCode',
                        country: '@address.Country',
                        isDefault: @(address.IsDefault ? "true" : "false")
                    },
                    </text>
                }
            };

            if (Object.keys(addressData).length > 0 && addressSelect) {
                addressSelect.addEventListener('change', function() {
                    if (this.value && this.value !== '0') {
                        const addr = addressData[this.value];
                        let defaultBadge = '';
                        if (addr.isDefault) {
                            defaultBadge = '<span style="display: inline-block; background-color: #10b981; color: white; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; margin-left: 0.5rem;">Default</span>';
                        }
                        previewContent.innerHTML = `
                            <div>${addr.street} ${defaultBadge}</div>
                            <div>${addr.city}, ${addr.state} ${addr.postal}</div>
                            <div>${addr.country}</div>
                        `;
                        addressPreview.style.display = 'block';
                    } else {
                        addressPreview.style.display = 'none';
                    }
                });

                // Show preview if there's a default address
                const defaultAddress = Object.entries(addressData).find(([key, val]) => val.isDefault);
                if (defaultAddress) {
                    addressSelect.value = defaultAddress[0];
                    addressSelect.dispatchEvent(new Event('change'));
                }
            }
        </script>
    }
</div>
