<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GroceryHub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Grocery_Ecomerce.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checkout.css" />
    <style>
        :root {
            --primary: #ff6b6b;
            --primary-dark: #ff5252;
            --secondary: #667eea;
            --text-dark: #1f2937;
            --text-light: #6b7280;
            --border: #e5e7eb;
            --bg-light: #f9fafb;
        }
        
        body {
            font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-dark);
        }

        header {
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .main-header {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .logo-block {
            display: flex;
            align-items: center;
            gap: 1rem;
            text-decoration: none;
            color: inherit;
        }

        .logo-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--primary), #ff9a9a);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1.5rem;
            box-shadow: 0 4px 15px rgba(255,107,107,0.3);
        }

        .logo-title {
            font-weight: 800;
            font-size: 1.3rem;
            color: var(--text-dark);
            margin: 0;
        }

        .logo-sub {
            font-size: 0.85rem;
            color: var(--text-light);
            margin: 0;
        }

        .nav-links {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            text-decoration: none;
            color: var(--text-light);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .nav-link:hover {
            color: var(--primary);
            background: rgba(255,107,107,0.08);
        }

        .nav-link.create-account {
            background: linear-gradient(135deg, var(--secondary), #764ba2);
            color: white;
            padding: 0.5rem 1.2rem;
        }

        .nav-link.create-account:hover {
            background: linear-gradient(135deg, #5568d3, #6a3fa0);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102,126,234,0.3);
        }

        .icon {
            font-size: 1.1rem;
        }

        .user-badge {
            background: linear-gradient(135deg, var(--secondary), #764ba2);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
        }

        .container {
            max-width: 1200px;
        }

        footer {
            background: white;
            border-top: 1px solid var(--border);
            margin-top: 3rem;
            padding: 2rem 0;
        }

        footer a {
            color: var(--primary);
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <header>
        <div class="main-header" role="navigation" aria-label="Main Navigation">
            <div class="logo-block">
                <a href="/" style="display: flex; align-items: center; gap: 1rem; text-decoration: none; color: inherit;">
                    <div class="logo-icon" aria-label="GroceryHub Logo">
                        <img src="https://thumbs.dreamstime.com/b/vegetables-shopping-cart-trolley-grocery-logo-icon-design-vector-171090350.jpg?w=768" alt="GroceryHub Logo" width="32" height="32">
                    </div>
                    <div>
                        <div class="logo-title">GroceryHub</div>
                        <div class="logo-sub">Fresh groceries delivered</div>
                    </div>
                </a>
            </div>
            <nav class="nav-links">
                <a class="nav-link" href="/">
                    <span class="icon" aria-hidden="true"></span> Home
                </a>
                <a class="nav-link" href="/Product/List">
                    <span class="icon" aria-hidden="true"></span> Shop
                </a>
                @{
                    var userId = Context.Session.GetInt32("UserId");
                    var userName = Context.Session.GetString("UserName");
                    var role = Context.Session.GetString("Role");
                }
                @if (userId.HasValue)
                {
                    <a class="nav-link" href="/Orders">
                        <span class="icon" aria-hidden="true"></span> Orders
                    </a>
                    <a class="nav-link" href="/User/Profile">
                        <span class="icon" aria-hidden="true"></span> Profile
                    </a>
                    <a class="nav-link" href="/Cart/ViewCart">
                        <span class="icon" aria-hidden="true"></span> Cart
                    </a>
                    <span class="user-badge">@userName</span>
                    <a class="nav-link" href="/Account/Logout">Logout</a>
                }
                else
                {
                    <a class="nav-link" href="/Account/Login">Sign In</a>
                    <a class="nav-link create-account" href="/Account/Register">Create Account</a>
                }
            </nav>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="text-muted">
        <div class="container">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem;">
                <div>
                    <strong>GroceryHub</strong><br>
                    Fresh groceries delivered to your doorstep
                </div>
                <div style="display: flex; gap: 2rem;">
                    <a href="/">Privacy Policy</a>
                    <a href="/">Terms of Service</a>
                    <a href="/">About Us</a>
                    <a href="/">Contact Us</a>
                </div>
                <div style="text-align: right;">
                    &copy; 2024 GroceryHub. All rights reserved.
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
