@using Grocery_Ecommerce.Models
@model UserProfileViewModel
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/user-profile.css" />

<div class="profile-container">
    <div class="profile-header">
        <h1>My Profile</h1>
        <p>Manage your account information and delivery addresses</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <span class="close" onclick="this.parentElement.style.display='none';">&times;</span>
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="profile-content">
        <!-- Sidebar Navigation -->
        <div class="profile-sidebar">
            <nav class="profile-nav">
                <a href="#personal-info" class="nav-link active" data-section="personal-info">
                    <span class="icon"></span>
                    <span>Personal Information</span>
                </a>
                <a href="#addresses" class="nav-link" data-section="addresses">
                    <span class="icon"></span>
                    <span>Addresses</span>
                </a>
                <a href="#security" class="nav-link" data-section="security">
                    <span class="icon"></span>
                    <span>Security</span>
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="profile-main">
            <!-- Personal Information Section -->
            <section id="personal-info" class="profile-section active">
                <div class="section-header">
                    <h2>Personal Information</h2>
                    <p>Update your profile details</p>
                </div>

                <form asp-action="UpdateProfile" method="post" class="profile-form">
                    <div class="form-group">
                        <label for="FullName">Full Name</label>
                        <input type="text" id="FullName" name="FullName" value="@Model.FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="Email">Email Address</label>
                        <input type="email" id="Email" name="Email" value="@Model.Email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="PhoneNumber">Phone Number</label>
                        <input type="tel" id="PhoneNumber" name="PhoneNumber" value="@(Model.PhoneNumber ?? "")" class="form-control" placeholder="(Optional)" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Member Since</label>
                        <input type="text" value="@Model.CreatedAt.ToString("MMMM dd, yyyy")" class="form-control" disabled />
                    </div>

                    <button type="submit" class="btn-primary">Save Changes</button>
                </form>
            </section>

            <!-- Addresses Section -->
            <section id="addresses" class="profile-section">
                <div class="section-header">
                    <h2>Delivery Addresses</h2>
                    <p>Manage your shipping addresses</p>
                    <button type="button" class="btn-secondary" onclick="openAddressForm(null)">+ Add New Address</button>
                </div>

                @if (Model.Addresses.Count == 0)
                {
                    <div class="empty-state">
                        <p>No addresses saved yet</p>
                        <button type="button" class="btn-primary" onclick="openAddressForm(null)">Add Your First Address</button>
                    </div>
                }
                else
                {
                    <div class="addresses-grid">
                        @foreach (var address in Model.Addresses)
                        {
                            <div class="address-card @(address.IsDefault ? "default" : "")">
                                <div class="address-header">
                                    <div class="address-label">
                                        @address.Street
                                        @if (address.IsDefault)
                                        {
                                            <span class="badge-default">Default</span>
                                        }
                                    </div>
                                    <div class="address-actions">
                                        <button type="button" class="btn-icon" onclick="openAddressForm(@address.AddressId)" title="Edit"></button>
                                        <button type="button" class="btn-icon" onclick="deleteAddress(@address.AddressId)" title="Delete"></button>
                                    </div>
                                </div>
                                <div class="address-details">
                                    <p>@address.City, @address.State @address.PostalCode</p>
                                    <p>@address.Country</p>
                                </div>
                                @if (!address.IsDefault)
                                {
                                    <button type="button" class="btn-link" onclick="setDefaultAddress(@address.AddressId); return false;">Set as Default</button>
                                }
                            </div>
                        }
                    </div>
                }

                <button type="button" class="btn-secondary" onclick="openAddressForm(null)" style="margin-top: 1.5rem;">+ Add Another Address</button>
            </section>

            <!-- Security Section -->
            <section id="security" class="profile-section">
                <div class="section-header">
                    <h2>Security</h2>
                    <p>Change your password</p>
                </div>

                <form asp-action="ChangePassword" method="post" class="profile-form">
                    <div class="form-group">
                        <label for="CurrentPassword">Current Password</label>
                        <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" required />
                        <span class="text-danger" id="currentPasswordError"></span>
                    </div>

                    <div class="form-group">
                        <label for="NewPassword">New Password</label>
                        <input type="password" id="NewPassword" name="NewPassword" class="form-control" required />
                        <span class="text-danger" id="newPasswordError"></span>
                    </div>

                    <div class="form-group">
                        <label for="ConfirmPassword">Confirm New Password</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" required />
                        <span class="text-danger" id="confirmPasswordError"></span>
                    </div>

                    <button type="submit" class="btn-primary">Change Password</button>
                </form>
            </section>
        </div>
    </div>

    <!-- Address Form Modal -->
    <div id="addressModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeAddressForm()">&times;</span>
            <h2 id="addressModalTitle">Add New Address</h2>
            <div id="addressFormContainer"></div>
        </div>
    </div>
</div>

<script>
    // Navigation between sections - FIXED: Use specific selector for profile sidebar only
    document.querySelectorAll('.profile-nav .nav-link').forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const sectionId = this.getAttribute('data-section');
            
            // Hide all sections
            document.querySelectorAll('.profile-section').forEach(section => {
                section.classList.remove('active');
            });
            
            // Remove active class from all profile nav links only
            document.querySelectorAll('.profile-nav .nav-link').forEach(navLink => {
                navLink.classList.remove('active');
            });
            
            // Show selected section
            document.getElementById(sectionId).classList.add('active');
            this.classList.add('active');
        });
    });

    function openAddressForm(addressId) {
        const modal = document.getElementById('addressModal');
        const title = document.getElementById('addressModalTitle');
        
        if (addressId) {
            title.textContent = 'Edit Address';
        } else {
            title.textContent = 'Add New Address';
        }

        // Load the form
        fetch(`/User/AddressForm?id=${addressId || ''}`)
            .then(response => {
                if (!response.ok) throw new Error('Failed to load form');
                return response.text();
            })
            .then(html => {
                document.getElementById('addressFormContainer').innerHTML = html;
                modal.style.display = 'block';
            })
            .catch(error => {
                console.error('Error:', error);
                showErrorMessage('Failed to load address form');
            });
    }

    function closeAddressForm() {
        const modal = document.getElementById('addressModal');
        modal.style.display = 'none';
        document.getElementById('addressFormContainer').innerHTML = '';
    }

    function saveAddress() {
        const form = document.getElementById('addressForm');
        
        // Validate form
        if (!form.reportValidity()) {
            return;
        }

        const formData = new FormData(form);

        fetch('/User/SaveAddress', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Network response was not ok');
            return response.json();
        })
        .then(data => {
            if (data.success) {
                closeAddressForm();
                showSuccessMessage(data.message);
                setTimeout(() => location.reload(), 1200);
            } else {
                const errors = Array.isArray(data.errors) ? data.errors.join(', ') : data.message;
                showErrorMessage(errors || 'Failed to save address');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showErrorMessage('An error occurred while saving the address');
        });
    }

    function deleteAddress(addressId) {
        if (confirm('Are you sure you want to delete this address?')) {
            fetch(`/User/DeleteAddress?id=${addressId}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    showSuccessMessage(data.message);
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showErrorMessage(data.message || 'Failed to delete address');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showErrorMessage('An error occurred while deleting the address');
            });
        }
    }

    function setDefaultAddress(addressId) {
        // Add visual feedback
        const button = event.target;
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = '⏳ Setting...';

        fetch(`/User/SetDefaultAddress?id=${addressId}`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Network response was not ok');
            return response.json();
        })
        .then(data => {
            if (data.success) {
                showSuccessMessage(data.message);
                setTimeout(() => location.reload(), 1200);
            } else {
                showErrorMessage(data.message || 'Failed to update default address');
                button.disabled = false;
                button.textContent = originalText;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showErrorMessage('An error occurred while updating the default address');
            button.disabled = false;
            button.textContent = originalText;
        });
    }

    function showSuccessMessage(message) {
        const alert = document.createElement('div');
        alert.className = 'alert alert-success';
        alert.innerHTML = `<span class="close" onclick="this.parentElement.style.display='none';">&times;</span><span>${message}</span>`;
        
        const container = document.querySelector('.profile-container');
        const firstChild = container.firstChild;
        container.insertBefore(alert, firstChild);
        
        // Auto-remove after 5 seconds
        setTimeout(() => {
            if (alert.parentNode) {
                alert.remove();
            }
        }, 5000);
    }

    function showErrorMessage(message) {
        const alert = document.createElement('div');
        alert.className = 'alert alert-error';
        alert.innerHTML = `<span class="close" onclick="this.parentElement.style.display='none';">&times;</span><span>${message}</span>`;
        
        const container = document.querySelector('.profile-container');
        const firstChild = container.firstChild;
        container.insertBefore(alert, firstChild);
        
        // Auto-remove after 5 seconds
        setTimeout(() => {
            if (alert.parentNode) {
                alert.remove();
            }
        }, 5000);
    }

    // Close modal when clicking outside
    window.onclick = function(event) {
        const modal = document.getElementById('addressModal');
        if (event.target === modal) {
            closeAddressForm();
        }
    }
</script>
